{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Коли Є",
  "mainBinaryName": "koly-widget",
  "version": "1.0.0",
  "identifier": "io.github.vkardin.koly.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Коли Є",
        "url": "index.html",
        "width": 340,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://vkardin.github.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "vkardin",
    "copyright": "© vkardin",
    "category": "Utility",
    "shortDescription": "Графіки відключень світла — віджет для робочого столу",
    "longDescription": "Неофіційний віджет із графіками планових відключень електроенергії для областей України.",
    "homepage": "https://vkardin.github.io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Ukrainian",
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Коли Є"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCRTExOUFBNTg0QTYzREMKUldUY1kwcFlxaG5oSzUvU2g4MG1qc2RObDdYM3RLL0NFcGNOK0ZoVUc2bHBvNzUvWEdKbUk5eDMK",
      "endpoints": [
        "https://github.com/vkardin/koly/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
